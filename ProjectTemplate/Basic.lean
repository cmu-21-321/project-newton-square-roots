
import Mathlib

namespace NewtonSquareRoots

-- One step of Newton's method for computing sqrt(a).
noncomputable def newtonStep (a x : ℝ) : ℝ :=
  (x + a / x) / 2

-- The sequence generated by Newton's method.
noncomputable def newtonSeq (a x₀ : ℝ) : ℕ → ℝ
  | 0 => x₀
  | n + 1 => newtonStep a (newtonSeq a x₀ n)

-- Lemma 1: A Newton step preserves positivity.
lemma newtonStep_pos
    (a x : ℝ) (ha : 0 < a) (hx : 0 < x) :
    0 < newtonStep a x := by
  unfold newtonStep
  positivity

-- Lemma 2: Every Newton iterate remains positive.
lemma newtonSeq_pos
    (a x₀ : ℝ) (ha : 0 < a) (hx₀ : 0 < x₀) :
    ∀ n : ℕ, 0 < newtonSeq a x₀ n := by
  intro n
  induction n with
  | zero =>
      exact hx₀
  | succ n ih =>
      change 0 < newtonStep a (newtonSeq a x₀ n)
      exact newtonStep_pos a (newtonSeq a x₀ n) ha ih

-- Lemma 3: One Newton step is at least sqrt(a).
lemma newtonStep_ge_sqrt
    (a x : ℝ) (ha : 0 < a) (hx : 0 < x) :
    Real.sqrt a ≤ newtonStep a x := by
  have hs : (Real.sqrt a)^2 = a :=
    Real.sq_sqrt (le_of_lt ha)
  have hid : newtonStep a x - Real.sqrt a =
      (x - Real.sqrt a)^2 / (2 * x) := by
    unfold newtonStep
    field_simp
    nlinarith [hs]
  apply sub_nonneg.mp
  rw [hid]
  positivity


-- Lemma 4: Every iterate after the first is at least sqrt(a).
lemma newtonSeq_ge_sqrt
    (a x₀ : ℝ) (ha : 0 < a) (hx₀ : 0 < x₀)
    (n : ℕ) :
    Real.sqrt a ≤ newtonSeq a x₀ (n + 1) := by
  change Real.sqrt a ≤
    newtonStep a (newtonSeq a x₀ n)
  exact newtonStep_ge_sqrt a
    (newtonSeq a x₀ n) ha
    (newtonSeq_pos a x₀ ha hx₀ n)

-- Lemma 5: A Newton step decreases x when x >= sqrt(a).
lemma newtonStep_le_self
    (a x : ℝ) (ha : 0 < a)
    (hx : Real.sqrt a ≤ x) :
    newtonStep a x ≤ x := by
  have hs : (Real.sqrt a)^2 = a :=
    Real.sq_sqrt (le_of_lt ha)
  have hx_pos : 0 < x :=
    lt_of_lt_of_le (Real.sqrt_pos.2 ha) hx
  have hsq : a ≤ x^2 := by
    have h := mul_nonneg
      (sub_nonneg.mpr hx)
      (add_nonneg (le_of_lt hx_pos)
        (Real.sqrt_nonneg a))
    nlinarith [hs]
  have hdiv : a / x ≤ x :=
    (div_le_iff₀ hx_pos).2 (by nlinarith [hsq])
  unfold newtonStep
  linarith

-- Lemma 6: Newton's sequence decreases after the first step.
lemma newtonSeq_mono
    (a x₀ : ℝ) (ha : 0 < a) (hx₀ : 0 < x₀)
    (n : ℕ) :
    newtonSeq a x₀ (n + 2) ≤
      newtonSeq a x₀ (n + 1) := by
  change newtonStep a (newtonSeq a x₀ (n + 1)) ≤
    newtonSeq a x₀ (n + 1)
  exact newtonStep_le_self a
    (newtonSeq a x₀ (n + 1)) ha
    (newtonSeq_ge_sqrt a x₀ ha hx₀ n)



-- Lemma 7: Exact error formula for one Newton step.
lemma newtonStep_error
    (a x : ℝ) (ha : 0 < a) (hx : 0 < x) :
    newtonStep a x - Real.sqrt a =
      (x - Real.sqrt a)^2 / (2 * x) := by
  have hs : (Real.sqrt a)^2 = a :=
    Real.sq_sqrt (le_of_lt ha)
  unfold newtonStep
  field_simp
  nlinarith [hs]

-- Lemma 8: Error formula for the Newton sequence.
lemma newtonSeq_error
    (a x₀ : ℝ) (ha : 0 < a) (hx₀ : 0 < x₀)
    (n : ℕ) :
    newtonSeq a x₀ (n + 1) - Real.sqrt a =
      (newtonSeq a x₀ n - Real.sqrt a)^2 /
        (2 * newtonSeq a x₀ n) := by
  change newtonStep a (newtonSeq a x₀ n) -
      Real.sqrt a =
    (newtonSeq a x₀ n - Real.sqrt a)^2 /
      (2 * newtonSeq a x₀ n)
  exact newtonStep_error a (newtonSeq a x₀ n)
    ha (newtonSeq_pos a x₀ ha hx₀ n)


-- Main Theorem: Newton's method converges to sqrt(a).
theorem newton_converges
    (a x₀ : ℝ) (ha : 0 < a) (hx₀ : 0 < x₀) :
    Filter.Tendsto (newtonSeq a x₀)
      Filter.atTop (nhds (Real.sqrt a)) := by
  sorry

end NewtonSquareRoots
